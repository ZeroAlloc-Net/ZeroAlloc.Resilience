<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds a consumer of the packed ZeroAlloc.Resilience package(s) with the oldest supported
    .NET SDK band, 10.0.1xx, whose compiler is Roslyn 5.0. The package bundles the generator in analyzers/dotnet/cs.
    A generator built against a newer Roslyn than the compiler that loads it is skipped with
    CS9057, and the build then fails because the generated code is missing.

    CS9057 is an error here as well. ZeroAlloc.StateMachine 1.8.2, a dependency of the package, also
    ships a generator built against Roslyn 5.0, so no package in this build may be skipped.

    The parent folder's global.json pins the 10.0.1xx band with rollForward latestPatch, so a
    newer band cannot stand in for it. Run locally with a 10.0.1xx SDK installed:
      unset v; r=$(od -An -N4 -tx4 /dev/urandom | tr -d " ") && [ -n "$r" ] && v=9.9.9-local.sha$(git rev-parse HEAD | cut -c1-7).$(date +%s).r$r
      dotnet pack ZeroAlloc.Resilience.slnx -c Release -o artifacts -p:Version=${v:?no random suffix}
      cd tests/ZeroAlloc.Resilience.Sdk10Smoke/Consumer
      dotnet run -c Release -p:ZeroAllocResilienceVersion=${v:?no random suffix}
    Each step stops when the random suffix cannot be generated; give each
    concurrent run its own worktree, because runs in one checkout share obj and bin.
    Not part of the solution; the sdk10-consumer job in ci.yml runs it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <WarningsAsErrors>$(WarningsAsErrors);CS8032;CS9057</WarningsAsErrors>
  </PropertyGroup>

  <Target Name="RequireZeroAllocResilienceVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(ZeroAllocResilienceVersion)' == ''"
           Text="Pass the version of the packed packages: -p:ZeroAllocResilienceVersion=..." />
  </Target>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Resilience" Version="[$(ZeroAllocResilienceVersion)]" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
  </ItemGroup>
</Project>
