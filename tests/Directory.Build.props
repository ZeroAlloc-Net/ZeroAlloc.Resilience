<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- Test projects: relax rules that don't apply to test code -->
    <NoWarn>$(NoWarn);MA0047;MA0004</NoWarn>
  </PropertyGroup>

  <!-- Code coverage for every test project. CI runs dotnet test with coverage.runsettings
       and uploads the Cobertura report to Codecov. -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
