<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <PackageId>ZeroAlloc.Resilience.Generator</PackageId>
    <Description>Source generator for ZeroAlloc.Resilience. Consumed automatically via ZeroAlloc.Resilience.</Description>
    <Version>0.0.0-local</Version>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!--
      The generator is bundled into ZeroAlloc.Resilience's NuGet package via the
      IncludeGeneratorInPackage target in the main library's csproj. Publishing a
      separate ZeroAlloc.Resilience.Generator package would just produce a broken
      stand-alone nupkg (DLL under lib/, not analyzers/), so suppress packing here.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Release tracking for the ZR diagnostics; RS2008 reads these. -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests read the parsed model for resolution the generated code does not show. -->
    <InternalsVisibleTo Include="ZeroAlloc.Resilience.Generator.Tests" />
  </ItemGroup>
</Project>
