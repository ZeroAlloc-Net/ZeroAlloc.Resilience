<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>ZeroAlloc.Resilience</PackageId>
    <Description>Source-generated, zero-allocation resilience policies for .NET. Add [Retry], [Timeout], [RateLimit], and [CircuitBreaker] to an interface; the generator emits a proxy composing all policies in declaration order. AOT-safe.</Description>
    <Version>0.0.0-local</Version>
    <IsAotCompatible>true</IsAotCompatible>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZeroAlloc.StateMachine" Version="1.5.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="ZeroAlloc.Pipeline" Version="1.2.2" />
    <PackageReference Include="ZeroAlloc.Collections" Version="1.1.5" />
    <PackageReference Include="ZeroAlloc.Results" Version="1.2.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\ZeroAlloc.Resilience.Generator\ZeroAlloc.Resilience.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <!--
    build/ makes ZeroAllocGeneratedAccessibility CompilerVisible for a project that references this
    package directly. buildTransitive/ does the same for a project that only gets it transitively,
    through a project reference to another project that references this package — the generator's
    analyzer, packed below, runs for those consumers too. See #152.
  -->
  <ItemGroup>
    <!-- Remove the implicit default-glob None items for these two files before re-adding them
         explicitly below, so pack metadata is set exactly once and dotnet pack does not fail with
         NETSDK1022 (duplicate 'None' items). -->
    <None Remove="build\ZeroAlloc.Resilience.props" />
    <None Remove="buildTransitive\ZeroAlloc.Resilience.props" />
    <None Include="$(MSBuildThisFileDirectory)build\ZeroAlloc.Resilience.props"
          Pack="true"
          PackagePath="build/ZeroAlloc.Resilience.props" />
    <None Include="$(MSBuildThisFileDirectory)buildTransitive\ZeroAlloc.Resilience.props"
          Pack="true"
          PackagePath="buildTransitive/ZeroAlloc.Resilience.props" />
  </ItemGroup>
  <Target Name="IncludeGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)..\ZeroAlloc.Resilience.Generator\bin\$(Configuration)\netstandard2.0\ZeroAlloc.Resilience.Generator.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>
</Project>
